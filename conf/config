#!/bin/zsh
# ==============================================================================
# Team of Six - Global Configuration
# ==============================================================================

export AI_USER="team_of_six"
export AI_GROUP="team_of_six"

export TOS_MNT_ROOT="/mnt/team_of_six"
export TOS_BIN="$TOS_MNT_ROOT/.local/bin"
export TOS_CONF="$TOS_MNT_ROOT/.local/conf"

# --- Global Control Plane (shared across all users) ---
export TOS_IPC_ROOT="$TOS_MNT_ROOT/.ipc"
export TOS_LOCKS="$TOS_IPC_ROOT/locks"

# --- Per-user IPC ribbon (resolved only when escalated via sudo) ---
if [[ -n "$SUDO_USER" ]]; then
    export TOS_IPC="$TOS_IPC_ROOT/$SUDO_USER"
    export TOS_INPUT="$TOS_IPC/inbox.md"
    export TOS_CONTEXT="$TOS_IPC/outbox.md"

    # Flattened sandbox: sandbox/$USER/<project>  (no tos_home nesting)
    export TOS_SANDBOX="$TOS_MNT_ROOT/sandbox/$SUDO_USER"
fi
