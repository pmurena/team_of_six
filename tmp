EOF
    run "$TOS_BIN_CMD" "$REPO_NAME" close trinity 1
    if [[ "$state" -ne 0 ]]; then echo "\n🚨 STEP 8 (CLOSE TRINITY) FAILED:\n$output\n" > /dev/tty; fi
    assert "$state" equals 0

    # ---------------------------------------------------------
