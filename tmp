    # ---------------------------------------------------------
    cat <<EOF > "$TOS_MNT_ROOT/.ipc/$ARCHITECT_USER/inbox.md"
===TOS_META_START===
CONFIRM=TRUE
===TOS_META_END===
EOF
    run "$TOS_BIN_CMD" "$REPO_NAME" delete project
    if [[ "$state" -ne 0 ]]; then echo "\n🚨 STEP 9 (DELETE PROJECT) FAILED:\n$output\n" > /dev/tty; fi
    assert "$state" equals 0
}
