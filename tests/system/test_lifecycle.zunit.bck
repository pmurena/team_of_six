#!/usr/bin/env zunit

@setup {
    if ! gh auth status -h github.com 2>&1 | grep -q "delete_repo"; then
        echo "🚨 [PRE-FLIGHT ERROR] MFA Authorization Required!"
        fail "Environment not authorized."
    fi

    export _ORIGINAL_PATH="$PATH"
    export REPO_NAME="tos-e2e-$(date +%s)"
    export TOS_MNT_ROOT=$(mktemp -d /tmp/tos_e2e_XXXXXX)
    export ARCHITECT_USER=$(whoami)
    export AI_USER="$ARCHITECT_USER"
    export AI_GROUP=$(id -gn)

    export TOS_MOCK_BIN="$TOS_MNT_ROOT/mock_bin"
    mkdir -p "$TOS_MOCK_BIN"
    cat <<'EOF' > "$TOS_MOCK_BIN/id"
#!/usr/bin/env zsh
echo "team_of_six"
EOF
    chmod +x "$TOS_MOCK_BIN/id"
    export PATH="$TOS_MOCK_BIN:$PATH"

    [[ -f "conf/config" ]] && cp conf/config conf/config.bak
    cat <<EOF > conf/config
export TOS_MNT_ROOT="$TOS_MNT_ROOT"
export TOS_BIN="\$TOS_MNT_ROOT/.local/bin"
export TOS_IPC="\$TOS_MNT_ROOT/.ipc"
export TOS_LOCKS="\$TOS_MNT_ROOT/.ipc/locks"
export TOS_SANDBOX="\$TOS_MNT_ROOT/sandbox"
export TOS_INPUT="\$TOS_MNT_ROOT/.ipc/$ARCHITECT_USER/inbox.md"
export TOS_CONTEXT="\$TOS_MNT_ROOT/.ipc/$ARCHITECT_USER/outbox.md"
export AI_USER="$AI_USER"
export AI_GROUP="$AI_GROUP"
EOF

    cp inf/tos_deploy.zsh /tmp/tos_deploy_test.zsh
    sed -i 's/\[\[ \$EUID -ne 0 \]\]/false/g' /tmp/tos_deploy_test.zsh
    sed -i 's/chown /true /g' /tmp/tos_deploy_test.zsh
    sed -i 's/chmod /true /g' /tmp/tos_deploy_test.zsh
    sed -i '/tos_add_user.zsh/s/^/#/' /tmp/tos_deploy_test.zsh
    sed -i '/tos.zsh sync/d' /tmp/tos_deploy_test.zsh
    sed -i '/sync project/d' /tmp/tos_deploy_test.zsh

    export GHOST_TOKEN=$(gh auth token)
    zsh /tmp/tos_deploy_test.zsh <<EOF
$GHOST_TOKEN
EOF

    export TOS_BIN_CMD="$TOS_MNT_ROOT/.local/bin/tos.zsh"
    chmod +x "$TOS_BIN_CMD"
    export TOS_CONTROLLER_LOCKED=true
    export SUDO_USER="$ARCHITECT_USER"
}

@teardown {
    # Backup safety net in case the Ghost's 'delete project' module fails
    gh repo delete "$REPO_NAME" --yes 2>/dev/null || true
    [[ -f "conf/config.bak" ]] && mv conf/config.bak conf/config
    rm -rf "$TOS_MNT_ROOT" /tmp/tos_deploy_test.zsh
    export PATH="$_ORIGINAL_PATH"
    unset _ORIGINAL_PATH
}

@test 'The Full Ghost Lifecycle Journey' {
    # ---------------------------------------------------------
    # STEP 1: Verify Gatekeeper
    # ---------------------------------------------------------
	echo "STEP 1: Verify Gatekeeper" > /dev/tty
    run "$TOS_BIN_CMD"
    if [[ "$state" -ne 1 ]]; then echo "\n🚨 STEP 1 FAILED:\n$output\n" > /dev/tty; fi
    assert "$state" equals 1

    # ---------------------------------------------------------
    # STEP 2: Project Inception
    # ---------------------------------------------------------
	echo "STEP 2: Project Inception" > /dev/tty
    cat <<EOF > "$TOS_MNT_ROOT/.ipc/$ARCHITECT_USER/inbox.md"
===TOS_META_START===
TARGET_PROJECT=$REPO_NAME
TITLE=$REPO_NAME
BODY=E2E Test Repo
===TOS_META_END===
EOF
    run "$TOS_BIN_CMD" "$REPO_NAME" create project
    if [[ "$state" -ne 0 ]]; then echo "\n🚨 STEP 2 (CREATE PROJECT) FAILED:\n$output\n" > /dev/tty; fi
    assert "$state" equals 0

    sleep 2

    # ---------------------------------------------------------
    # STEP 3: Create Issue
    # ---------------------------------------------------------
	echo "STEP 3: Create Issue" > /dev/tty
    cat <<EOF > "$TOS_MNT_ROOT/.ipc/$ARCHITECT_USER/inbox.md"
===TOS_ISSUE_START===
TITLE=E2E Feature
BODY=Testing the full spectrum lifecycle
===TOS_ISSUE_END===
EOF
    run "$TOS_BIN_CMD" "$REPO_NAME" create issue
    if [[ "$state" -ne 0 ]]; then echo "\n🚨 STEP 3 (CREATE ISSUE) FAILED:\n$output\n" > /dev/tty; fi
    assert "$state" equals 0

    # ---------------------------------------------------------
    # STEP 4: Create Trinity 1
    # ---------------------------------------------------------
	echo "STEP 4: Create Trinity 1" > /dev/tty
    run "$TOS_BIN_CMD" "$REPO_NAME" create trinity 1
    if [[ "$state" -ne 0 ]]; then echo "\n🚨 STEP 4 (CREATE TRINITY) FAILED:\n$output\n" > /dev/tty; fi
    assert "$state" equals 0

    # ---------------------------------------------------------
    # STEP 5: Sync Trinity (Acquire Hard Lock)
    # ---------------------------------------------------------
	echo "STEP 5: Sync Trinity (Acquire Hard Lock)" > /dev/tty
    run "$TOS_BIN_CMD" "$REPO_NAME" sync trinity 1
    if [[ "$state" -ne 0 ]]; then echo "\n🚨 STEP 5 (SYNC TRINITY) FAILED:\n$output\n" > /dev/tty; fi
    assert "$state" equals 0

    # ---------------------------------------------------------
    # STEP 6: Write Plan (Generate Manifest Visa)
    # ---------------------------------------------------------
	echo "STEP 6: Write Plan (Generate Manifest Visa)" > /dev/tty

    cat <<EOF > "$TOS_MNT_ROOT/.ipc/$ARCHITECT_USER/inbox.md"
===TOS_PLAN_START===
APPROVED_FILES=README.md
===TOS_PLAN_END===
EOF
    run "$TOS_BIN_CMD" "$REPO_NAME" write plan
    if [[ "$state" -ne 0 ]]; then echo "\n🚨 STEP 6 (WRITE PLAN) FAILED:\n$output\n" > /dev/tty; fi
    assert "$state" equals 0


# ---------------------------------------------------------
    # MANUAL VALIDATION PAUSE
    # ---------------------------------------------------------
    echo "\n🛑 [E2E PAUSED] Journey Complete for: $REPO_NAME" > /dev/tty
    echo "🌐 Go check your GitHub profile! You should see:" > /dev/tty
    echo "   1. A successfully merged PR." > /dev/tty
    echo "   2. The 'tos-work-1' branch deleted." > /dev/tty
    echo "   3. Your 'Updated by the Ghost...' text in the main README." > /dev/tty
    
    # FORCE input from the physical keyboard
    read -k 1 "?Press ANY KEY to test the Ghost's DELETE PROJECT module... " < /dev/tty
    
    echo "\n🧹 Executing Ghost Annihilation Protocol..." > /dev/tty
