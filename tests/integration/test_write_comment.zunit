#!/usr/bin/env zunit
# =============================================================================
# test/integration/test_write_comment.zunit
# =============================================================================
# WHAT IS TESTED
#   bin/modules/write/hard/comment.zsh (or soft/) — posts a COMMENT block's
#   BODY to the GitHub thread identified by TARGET.
#
# ROUTING LOGIC
#   The module checks whether a PR exists for the given TARGET number.
#   If yes → `gh pr comment`
#   If no  → `gh issue comment` (fallback)
#
#   This is important because early in a trinity no PR exists yet; comments
#   must still reach the Architect via the issue thread.
# =============================================================================

@setup {
    source "${ZUNIT_TEST_DIR}/../helpers/scaffold.zsh"
    source "${ZUNIT_TEST_DIR}/../helpers/mocks.zsh"
    source "${ZUNIT_TEST_DIR}/../helpers/assertions.zsh"
    scaffold_setUp
    reset_mocks

    _FIXTURES="${ZUNIT_TEST_DIR}/../fixtures/payloads"

    echo "test_architect:HARD_LOCK" > "${TOS_LOCKS}/test-project_trinity_1.lock"
    export TOS_ACTIVE_TRINITY="1"
}

@teardown {
    scaffold_tearDown
}

# ---------------------------------------------------------------------------
# TEST 1 — Positive: comment posted to PR when PR exists for the target
# ---------------------------------------------------------------------------
@test "[write comment — positive, PR exists] Comment posted to PR when PR found" {
    scaffold_write_inbox "${_FIXTURES}/valid_comment.md"

    # Simulate `gh pr view 1` returning a valid PR URL (PR exists).
    export TOS_MOCK_GH_OUTPUT='{"url":"https://github.com/org/test-project/pull/1","state":"OPEN"}'

    local exit_code
    zsh bin/tos.zsh test-project write comment 2>&1
    exit_code=$?

    assert equal "${exit_code}" "0"

    assert_mock_called     /tmp/tos_mock_gh_calls.log "pr comment"
    assert_mock_not_called /tmp/tos_mock_gh_calls.log "issue comment"
    assert_file_empty "${TOS_INBOX}"
}

# ---------------------------------------------------------------------------
# TEST 2 — Positive: falls back to issue comment when no PR exists
# ---------------------------------------------------------------------------
@test "[write comment — positive, no PR] Fallback to issue comment when PR absent" {
    scaffold_write_inbox "${_FIXTURES}/valid_comment.md"

    # Make `gh pr view` fail (PR does not exist yet).
    export TOS_MOCK_GH_EXIT_pr="1"

    local exit_code
    zsh bin/tos.zsh test-project write comment 2>&1
    exit_code=$?

    assert equal "${exit_code}" "0"
    assert_mock_called /tmp/tos_mock_gh_calls.log "issue comment"
}

# ---------------------------------------------------------------------------
# TEST 3 — Negative: missing TARGET field causes abort
# ---------------------------------------------------------------------------
@test "[write comment — negative] Missing TARGET causes abort without any gh call" {
    cat > "${TOS_INBOX}" <<'PAYLOAD'
===TOS_COMMENT_START===
BODY=There is no TARGET field here.
===TOS_COMMENT_END===
PAYLOAD

    local exit_code
    zsh bin/tos.zsh test-project write comment 2>&1
    exit_code=$?

    assert not_equal "${exit_code}" "0"
    assert_mock_not_called /tmp/tos_mock_gh_calls.log "comment"
}
