#!/usr/bin/env zunit

@setup {
    source "${PWD}/tests/shared/zunit_helpers/scaffold.zsh"
    source "${PWD}/tests/shared/zunit_helpers/mocks.zsh"
    source "${PWD}/tests/shared/zunit_helpers/assertions.zsh"
    
    scaffold_setUp
    reset_mocks

    _FIXTURES="${PWD}/tests/shared/payloads"

    export TOS_MOCK_BIN="/tmp/tos_mock_bin_$$"
    mkdir -p "${TOS_MOCK_BIN}"
    export PATH="${TOS_MOCK_BIN}:/usr/local/bin:/usr/bin:/bin:$PATH"

    cat > "${TOS_MOCK_BIN}/git" <<'INNEREOF'
#!/usr/bin/env zsh
echo "$*" >> /tmp/tos_mock_git_calls.log

if [[ "$1" == "rev-parse" && "$*" == *"--abbrev-ref HEAD"* ]]; then
    echo "tos-work-1"
    exit 0
elif [[ "$1" == "push" ]]; then
    if [[ -n "$TOS_MOCK_GIT_EXIT_push" ]]; then
        echo "fatal: remote error" >&2
        exit "$TOS_MOCK_GIT_EXIT_push"
    fi
    exit 0
elif [[ "$1" == "add" || "$1" == "commit" || "$1" == "diff" || "$1" == "ls-files" ]]; then
    exit 0
fi

REAL_GIT=$(command -v git | grep -v "tos_mock_bin" | head -n 1)
[[ -z "$REAL_GIT" ]] && REAL_GIT="/usr/bin/git"
"$REAL_GIT" "$@"
exit $?
INNEREOF
    chmod +x "${TOS_MOCK_BIN}/git"

    cat > "${TOS_MOCK_BIN}/gh" <<'INNEREOF'
#!/usr/bin/env zsh
echo "$*" >> /tmp/tos_mock_gh_calls.log
exit 0
INNEREOF
    chmod +x "${TOS_MOCK_BIN}/gh"

    mkdir -p "${TOS_MNT_ROOT}/.local/bin/modules/write/hard"
    mkdir -p "${TOS_MNT_ROOT}/.local/bin/utils"
    cp -r "${PWD}/bin/modules/write/hard/"* "${TOS_MNT_ROOT}/.local/bin/modules/write/hard/" 2>/dev/null || true
    cp -r "${PWD}/bin/utils/"* "${TOS_MNT_ROOT}/.local/bin/utils/" 2>/dev/null || true

    export _SANDBOX_PROJECT="${TOS_SANDBOX}/team_of_six"
    mkdir -p "${_SANDBOX_PROJECT}"

    export TOS_OUTBOX="${TOS_MNT_ROOT}/.ipc/test_architect/outbox.md"
    mkdir -p "$(dirname "${TOS_OUTBOX}")"
    touch "${TOS_OUTBOX}"

    export TOS_INBOX="${TOS_MNT_ROOT}/.ipc/test_architect/inbox.md"
    mkdir -p "$(dirname "${TOS_INBOX}")"
    touch "${TOS_INBOX}"

    export TOS_CONTEXT="/dev/null"
    
    echo "test_architect:HARD_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_1.lock"
    echo "calculator.zsh test_calculator.zsh" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    export TOS_ACTIVE_TRINITY="1"
}

@teardown {
    scaffold_tearDown
    rm -rf "${TOS_MOCK_BIN}" 2>/dev/null
}

@test '[write code — positive] Single file written to sandbox, committed, pushed' {
    scaffold_write_inbox "${_FIXTURES}/valid_file_single.md"
    
    sed -i 's/TARGET_PROJECT=.*/TARGET_PROJECT=team_of_six/g' "${TOS_INBOX}" 2>/dev/null || true
    sed -i 's/TARGET_TRINITY=.*/TARGET_TRINITY=1/g' "${TOS_INBOX}" 2>/dev/null || true

    local output
    output=$(zsh bin/tos.zsh team_of_six write code 2>&1) || true

    assert_file_exists "${_SANDBOX_PROJECT}/calculator.zsh"
    
    local content=$(<"${_SANDBOX_PROJECT}/calculator.zsh" 2>/dev/null || echo "")
    [[ "$content" == *"add()"* ]] && assert 1 equals 1 || fail "File written, but content missing 'add()'"

    local git_log=$(cat /tmp/tos_mock_git_calls.log 2>/dev/null || echo "")
    [[ "$git_log" == *"add "* ]] && assert 1 equals 1 || fail "git add not called"
    [[ "$git_log" == *"commit "* ]] && assert 1 equals 1 || fail "git commit not called"
    [[ "$git_log" == *"push "* ]] && assert 1 equals 1 || fail "git push not called"

    [[ -s "${TOS_OUTBOX}" ]] && assert 1 equals 1 || fail "Outbox must not be empty"
    [[ ! -s "${TOS_INBOX}" ]] && assert 1 equals 1 || fail "Inbox must be empty (ADR 10)"
}

@test '[write code — positive, multi-file] Both files written with exactly one commit' {
    echo "calculator.zsh test_calculator.zsh" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    scaffold_write_inbox "${_FIXTURES}/valid_file_double.md"
    
    sed -i 's/TARGET_PROJECT=.*/TARGET_PROJECT=team_of_six/g' "${TOS_INBOX}" 2>/dev/null || true
    sed -i 's/TARGET_TRINITY=.*/TARGET_TRINITY=1/g' "${TOS_INBOX}" 2>/dev/null || true

    local output
    output=$(zsh bin/tos.zsh team_of_six write code 2>&1) || true

    assert_file_exists "${_SANDBOX_PROJECT}/calculator.zsh"
    assert_file_exists "${_SANDBOX_PROJECT}/test_calculator.zsh"

    local commit_count=$(grep -c "commit" /tmp/tos_mock_git_calls.log 2>/dev/null || echo 0)
    assert "${commit_count}" equals 1
}

@test '[write code — negative, SEC-FAULT] File not in manifest causes violent abort' {
    echo "calculator.zsh" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    scaffold_write_inbox "${_FIXTURES}/file_outside_manifest.md"
    
    sed -i 's/TARGET_PROJECT=.*/TARGET_PROJECT=team_of_six/g' "${TOS_INBOX}" 2>/dev/null || true
    sed -i 's/TARGET_TRINITY=.*/TARGET_TRINITY=1/g' "${TOS_INBOX}" 2>/dev/null || true

    local output
    output=$(zsh bin/tos.zsh team_of_six write code 2>&1) || true

    assert_file_not_exists "${_SANDBOX_PROJECT}/rogue.zsh"

    if echo "${output}" | grep -qi "SEC-FAULT"; then
        assert 1 equals 1
    else
        fail "Expected SEC-FAULT but got: \n${output}"
    fi
}

@test '[write code — negative, path traversal] Traversal path violently rejected' {
    echo "../../etc/passwd" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    scaffold_write_inbox "${_FIXTURES}/file_path_traversal.md"

    sed -i 's/TARGET_PROJECT=.*/TARGET_PROJECT=team_of_six/g' "${TOS_INBOX}" 2>/dev/null || true
    sed -i 's/TARGET_TRINITY=.*/TARGET_TRINITY=1/g' "${TOS_INBOX}" 2>/dev/null || true

    local output
    output=$(zsh bin/tos.zsh team_of_six write code 2>&1) || true

    local found=$(find "${TOS_SANDBOX}" -name "passwd" 2>/dev/null | wc -l)
    assert "${found}" equals 0

    if echo "${output}" | grep -qi "SEC-FAULT"; then
        assert 1 equals 1
    else
        fail "Expected SEC-FAULT but got: \n${output}"
    fi
}

@test '[write code — negative, push failure] Inbox truncated before push fails' {
    echo "calculator.zsh" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    scaffold_write_inbox "${_FIXTURES}/valid_file_single.md"

    sed -i 's/TARGET_PROJECT=.*/TARGET_PROJECT=team_of_six/g' "${TOS_INBOX}" 2>/dev/null || true
    sed -i 's/TARGET_TRINITY=.*/TARGET_TRINITY=1/g' "${TOS_INBOX}" 2>/dev/null || true

    export TOS_MOCK_GIT_EXIT_push="1"

    local output
    output=$(zsh bin/tos.zsh team_of_six write code 2>&1) || true

    if echo "${output}" | grep -qi "Push failed"; then
        assert 1 equals 1
    else
        fail "Expected push failure but got: \n${output}"
    fi

    [[ ! -s "${TOS_INBOX}" ]] && assert 1 equals 1 || fail "Inbox was NOT empty! ADR 10 violated."
}

@test '[write code — negative, no manifest] Blocked when no write plan issued' {
    rm -f "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    scaffold_write_inbox "${_FIXTURES}/valid_file_single.md"

    sed -i 's/TARGET_PROJECT=.*/TARGET_PROJECT=team_of_six/g' "${TOS_INBOX}" 2>/dev/null || true
    sed -i 's/TARGET_TRINITY=.*/TARGET_TRINITY=1/g' "${TOS_INBOX}" 2>/dev/null || true

    local output
    output=$(zsh bin/tos.zsh team_of_six write code 2>&1) || true

    assert_file_not_exists "${_SANDBOX_PROJECT}/calculator.zsh"

    if echo "${output}" | grep -qi "manifest"; then
        assert 1 equals 1
    else
        fail "Expected manifest missing error but got: \n${output}"
    fi
}
