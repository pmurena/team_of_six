#!/usr/bin/env zunit
@setup {
    source "${PWD}/tests/helpers/scaffold.zsh"
    source "${PWD}/tests/helpers/mocks.zsh"
    source "${PWD}/tests/helpers/assertions.zsh"
    scaffold_setUp
    echo "test_architect:HARD_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_1.lock"
    echo "calculator.zsh" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    export TOS_ACTIVE_TRINITY="1"
    : > /tmp/tos_order.log
}
@teardown { scaffold_tearDown; rm -f /tmp/tos_order.log; }

@test 'Inbox truncated before git commit in write code (ADR 10)' {
    cat > "${TOS_INBOX}" <<'PAYLOAD'
===TOS_META_START===
TARGET_PROJECT=team_of_six
TARGET_TRINITY=1
===TOS_META_END===
===TOS_FILE_START: test.zsh===
content
===TOS_FILE_END===
PAYLOAD

    cat > "$TOS_MOCK_BIN/git" <<'INNER'
#!/usr/bin/env zsh
if [[ "$*" == *commit* ]]; then
    echo "INBOX_SIZE_AT_COMMIT=$(wc -c < "$TOS_INBOX")" >> /tmp/tos_order.log
fi
INNER
    chmod +x "$TOS_MOCK_BIN/git"

    zsh bin/tos.zsh team_of_six write code 2>&1
    assert_file_contains /tmp/tos_order.log "INBOX_SIZE_AT_COMMIT=0"
}

@test 'Inbox truncated before gh issue create in create issue (ADR 10)' {
    echo "test_architect:SOFT_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_0.lock"
    export TOS_ACTIVE_TRINITY="0"
    
    cat > "${TOS_INBOX}" <<'PAYLOAD'
===TOS_ISSUE_START===
TITLE=Truncation test
===TOS_ISSUE_END===
PAYLOAD

    cat > "$TOS_MOCK_BIN/gh" <<'INNER'
#!/usr/bin/env zsh
if [[ "$*" == *"issue create"* ]]; then
    echo "INBOX_SIZE_AT_ISSUE_CREATE=$(wc -c < "$TOS_INBOX")" >> /tmp/tos_order.log
fi
INNER
    chmod +x "$TOS_MOCK_BIN/gh"

    zsh bin/tos.zsh team_of_six create issue 2>&1
    assert_file_contains /tmp/tos_order.log "INBOX_SIZE_AT_ISSUE_CREATE=0"
}

@test 'Inbox truncated before gh pr merge in close trinity (ADR 10)' {
    cat > "${TOS_INBOX}" <<'PAYLOAD'
===TOS_META_START===
TARGET_PROJECT=team_of_six
TARGET_TRINITY=1
CONFIRM=TRUE
===TOS_META_END===
PAYLOAD

    cat > "$TOS_MOCK_BIN/gh" <<'INNER'
#!/usr/bin/env zsh
if [[ "$*" == *"pr merge"* ]]; then
    echo "INBOX_SIZE_AT_PR_MERGE=$(wc -c < "$TOS_INBOX")" >> /tmp/tos_order.log
fi
INNER
    chmod +x "$TOS_MOCK_BIN/gh"

    zsh bin/tos.zsh team_of_six close trinity 1 2>&1
    assert_file_contains /tmp/tos_order.log "INBOX_SIZE_AT_PR_MERGE=0"
}
