#!/usr/bin/env zunit
# =============================================================================
# test/integration/test_sync_module.zunit
# =============================================================================

@setup {
    source "${PWD}/tests/helpers/scaffold.zsh"
    source "${PWD}/tests/helpers/mocks.zsh"
    source "${PWD}/tests/helpers/assertions.zsh"
    
    scaffold_setUp
    reset_mocks

    _FIXTURES="${PWD}/tests/fixtures/payloads"
    
    # 1. PHYSICAL HYBRID MOCK
    export TOS_MOCK_BIN="/tmp/tos_mock_bin_$$"
    mkdir -p "${TOS_MOCK_BIN}"
    export PATH="${TOS_MOCK_BIN}:$PATH"

    cat > "${TOS_MOCK_BIN}/git" <<'EOF'
#!/usr/bin/env zsh
echo "$*" >> /tmp/tos_mock_git_calls.log

# FAKE THE MUTATING ACTIONS
if [[ "$1" == "clone" ]]; then
    mkdir -p "${_SANDBOX_PROJECT}/.git"
    exit 0
elif [[ "$1" == "push" ]]; then
    if [[ -n "$TOS_MOCK_GIT_EXIT_push" ]]; then
        echo "fatal: remote error: upload-pack: not our ref" >&2
        exit "$TOS_MOCK_GIT_EXIT_push"
    fi
    exit 0
elif [[ "$1" == "pull" || "$1" == "rebase" || "$1" == "reset" || "$1" == "checkout" || "$1" == "branch" || "$1" == "add" || "$1" == "commit" ]]; then
    exit 0
fi

# PASS VALIDATION CHECKS TO THE REAL SYSTEM GIT
REAL_GIT=$(command -v git | grep -v "tos_mock_bin" | head -n 1)
[[ -z "$REAL_GIT" ]] && REAL_GIT="/usr/bin/git"
"$REAL_GIT" "$@"
exit $?
EOF
    chmod +x "${TOS_MOCK_BIN}/git"

    cat > "${TOS_MOCK_BIN}/gh" <<'EOF'
#!/usr/bin/env zsh
echo "$*" >> /tmp/tos_mock_gh_calls.log
if [[ -n "$TOS_MOCK_GH_OUTPUT" ]]; then
    echo "$TOS_MOCK_GH_OUTPUT"
fi
exit 0
EOF
    chmod +x "${TOS_MOCK_BIN}/gh"

    # 2. MODULE INJECTION
    mkdir -p "${TOS_MNT_ROOT}/.local/bin/modules/sync/soft"
    mkdir -p "${TOS_MNT_ROOT}/.local/bin/modules/sync/hard"
    cp -r "${PWD}/bin/modules/sync/soft/"* "${TOS_MNT_ROOT}/.local/bin/modules/sync/soft/" 2>/dev/null || true

    # 3. ALIGN SANDBOX
    export _SANDBOX_PROJECT="${TOS_SANDBOX}/team_of_six"
    
    # 4. EXPLICIT OUTBOX
    export TOS_OUTBOX="${TOS_MNT_ROOT}/.ipc/test_architect/outbox.md"
    mkdir -p "$(dirname "${TOS_OUTBOX}")"
    touch "${TOS_OUTBOX}"
    
    export TOS_CONTEXT="/dev/null"
    export TOS_ACTIVE_TRINITY="0"
}

@teardown {
    scaffold_tearDown
    rm -rf "${TOS_MOCK_BIN}" 2>/dev/null
}

# ===========================================================================
# sync project
# ===========================================================================

@test '[sync project — positive] Provisions sandbox, clones repo, acquires SOFT_LOCK' {
    assert_dir_not_exists "${_SANDBOX_PROJECT}"

    local output
    local exit_code=0
    output=$(zsh bin/tos.zsh team_of_six sync project 2>&1) || exit_code=$?

    if [[ "${exit_code}" -ne 0 ]]; then
        fail "Gateway failed unexpectedly: ${output}"
    fi
    assert "${exit_code}" equals 0
    
    local git_log=$(cat /tmp/tos_mock_git_calls.log 2>/dev/null || echo "")
    [[ "$git_log" == *"clone"* ]] && assert 1 equals 1 || fail "git clone not called"

    assert_file_exists "${TOS_LOCKS}/team_of_six_trinity_0.lock"
    
    local lock_data=$(<"${TOS_LOCKS}/team_of_six_trinity_0.lock")
    [[ "$lock_data" == *"SOFT_LOCK"* ]] && assert 1 equals 1 || fail "Lock missing SOFT_LOCK"

    [[ -s "${TOS_OUTBOX}" ]] && assert 1 equals 1 || fail "Outbox is empty"
}

@test '[sync project — negative] Second call rejected when sandbox already exists' {
    mkdir -p "${_SANDBOX_PROJECT}/.git"

    local output
    local exit_code=0
    output=$(zsh bin/tos.zsh team_of_six sync project 2>&1) || exit_code=$?

    if echo "${output}" | grep -qi "already exists\|already provisioned\|duplicate\|exists"; then
        assert 1 equals 1
    else
        fail "Did not output rejection message. Exit: ${exit_code}. Output: ${output}"
    fi
}

# ===========================================================================
# sync trinity (Atomic Handover)
# ===========================================================================

@test '[sync trinity — positive] Atomic Handover: push → release old lock → acquire new → snapshot' {
    echo "test_architect:HARD_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_1.lock"
    export TOS_ACTIVE_TRINITY="1"
    mkdir -p "${_SANDBOX_PROJECT}/.git"

    local output
    local exit_code=0
    echo "change" > "${_SANDBOX_PROJECT}/trigger.txt"
    git -C "${_SANDBOX_PROJECT}" add trigger.txt 2>/dev/null || true
    output=$(zsh bin/tos.zsh team_of_six sync trinity 2 2>&1) || exit_code=$?

    if [[ "${exit_code}" -ne 0 ]]; then
        fail "Gateway failed unexpectedly: ${output}"
    fi
    assert "${exit_code}" equals 0
    
    local git_log=$(cat /tmp/tos_mock_git_calls.log 2>/dev/null || echo "")
    [[ "$git_log" == *"push"* ]] && assert 1 equals 1 || fail "git push not called"

    assert_file_not_exists "${TOS_LOCKS}/team_of_six_trinity_1.lock"
    assert_file_exists "${TOS_LOCKS}/team_of_six_trinity_2.lock"
}

@test '[sync trinity — negative] Push failure halts with no self-healing (ADR 11)' {
    echo "test_architect:HARD_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_1.lock"
    export TOS_ACTIVE_TRINITY="1"
    mkdir -p "${_SANDBOX_PROJECT}/.git"

    export TOS_MOCK_GIT_EXIT_push="1"

    local output
    local exit_code=0
    echo "change" > "${_SANDBOX_PROJECT}/trigger.txt"
    git -C "${_SANDBOX_PROJECT}" add trigger.txt 2>/dev/null || true
    output=$(zsh bin/tos.zsh team_of_six sync trinity 2 2>&1) || exit_code=$?

    if echo "${output}" | grep -qi "push\|fatal\|error"; then
        assert 1 equals 1
    else
        fail "Output did not indicate push failure. Output: ${output}"
    fi

    # CORRECTED ARCHITECTURAL BEHAVIOR: 
    # The script pushes BEFORE acquiring the new lock. 
    # Because the push fails and triggers an immediate exit, Lock 2 is never created.
    assert_file_not_exists "${TOS_LOCKS}/team_of_six_trinity_2.lock"

    # ADR 11 validation: No self-healing commands triggered
    local git_log=$(cat /tmp/tos_mock_git_calls.log 2>/dev/null || echo "")
    [[ "$git_log" == *"rebase"* ]] && fail "Rebase called!"
    [[ "$git_log" == *"pull"* ]] && fail "Pull called!"
    assert 1 equals 1
}

# ===========================================================================
# sync peek
# ===========================================================================

@test '[sync peek — positive] File content appended to outbox without snapshot reset' {
    echo "test_architect:HARD_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_1.lock"
    export TOS_ACTIVE_TRINITY="1"
    mkdir -p "${_SANDBOX_PROJECT}/.git"

    echo '#!/bin/zsh' > "${_SANDBOX_PROJECT}/calculator.zsh"
    echo 'add() { echo $(( $1 + $2 )); }' >> "${_SANDBOX_PROJECT}/calculator.zsh"

    local output
    local exit_code=0
    output=$(zsh bin/tos.zsh team_of_six sync peek calculator.zsh 2>&1) || exit_code=$?

    if [[ "${exit_code}" -ne 0 ]]; then
        fail "Gateway failed unexpectedly: ${output}"
    fi
    assert "${exit_code}" equals 0

    local outbox_data=$(<"${TOS_OUTBOX}")
    if [[ "$outbox_data" == *"add()"* ]]; then
        assert 1 equals 1
    else
        fail "Content not appended. Outbox contains: ${outbox_data}"
    fi
}

@test '[sync peek — negative] Non-existent file causes graceful error' {
    echo "test_architect:HARD_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_1.lock"
    export TOS_ACTIVE_TRINITY="1"
    mkdir -p "${_SANDBOX_PROJECT}/.git"

    local output
    local exit_code=0
    output=$(zsh bin/tos.zsh team_of_six sync peek does_not_exist.zsh 2>&1) || exit_code=$?

    if echo "${output}" | grep -qi "not found\|no such file\|missing\|cannot open"; then
        assert 1 equals 1
    else
        fail "Incorrect error handling. Exit: ${exit_code}. Output: ${output}"
    fi
}
