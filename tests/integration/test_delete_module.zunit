#!/usr/bin/env zunit
# =============================================================================
# test/integration/test_delete_module.zunit
# =============================================================================
# WHAT IS TESTED
#   bin/modules/delete/soft/project.zsh — the nuclear purge command.
#   It permanently deletes the GitHub repository and removes the local sandbox.
#
# PAT MFA ISOLATION (ADR 13)
#   The `delete_repo` scope is NOT included in the standard PAT. Before
#   issuing `gh repo delete`, the module must call:
#       gh auth refresh -s delete_repo
#   to interactively add the scope. After the deletion (whether it succeeds
#   or fails), an EXIT trap must revoke the elevated scope:
#       gh auth refresh --remove-scopes delete_repo
#
#   This ensures the dangerous scope is ephemeral — it exists only for the
#   duration of the delete operation.
#
# KEY ASSERTIONS
#   1. `auth refresh -s delete_repo` appears BEFORE `repo delete` in the log.
#   2. `auth refresh --remove-scopes delete_repo` appears AFTER — even on failure.
#   3. CONFIRM=TRUE is required (HITL gate).
# =============================================================================

@setup {
    source "${PWD}/tests/helpers/scaffold.zsh"
    source "${PWD}/tests/helpers/mocks.zsh"
    source "${PWD}/tests/helpers/assertions.zsh"
    scaffold_setUp
    reset_mocks

    _FIXTURES="${PWD}/tests/fixtures/payloads"

    # delete project is a soft/ module — soft lock context.
    echo "test_architect:SOFT_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_0.lock"
    export TOS_ACTIVE_TRINITY="0"

    _SANDBOX_PROJECT="${TOS_SANDBOX}/test_architect/team_of_six"
    mkdir -p "${_SANDBOX_PROJECT}"
}

@teardown {
    scaffold_tearDown
}

# ---------------------------------------------------------------------------
# TEST 1 — Positive: MFA escalation called before repo delete; scope revoked after
# ---------------------------------------------------------------------------
@test '[delete project — positive] PAT MFA escalation before delete; scope revoked in EXIT trap' {
    scaffold_write_inbox "${_FIXTURES}/meta_confirm_zero.md"

    local exit_code
    zsh bin/tos.zsh team_of_six delete project 2>&1
    exit_code=$?

    assert "${exit_code}" equals "0"

    # auth refresh (escalate) must come before repo delete in the call log.
    assert_mock_call_order \
        /tmp/tos_mock_gh_calls.log \
        "auth refresh" \
        "repo delete"

    # After deletion, scope must be revoked (EXIT trap).
    assert_mock_called /tmp/tos_mock_gh_calls.log "auth refresh --remove-scopes delete_repo"

    # Sandbox must be cleaned up.
    assert_dir_not_exists "${_SANDBOX_PROJECT}"

    assert_file_empty "${TOS_INBOX}"
}

# ---------------------------------------------------------------------------
# TEST 2 — Negative: scope revocation fires even when repo delete fails
# ---------------------------------------------------------------------------
# The EXIT trap must be unconditional — it cannot be skipped by a mid-execution
# failure. This is the critical security property: even if the repo delete
# command errors out, the elevated scope is removed.
@test '[delete project — negative] Scope revocation fires even when repo delete fails' {
    scaffold_write_inbox "${_FIXTURES}/meta_confirm_zero.md"

    # Make the `gh repo delete` call fail.
    export TOS_MOCK_GH_EXIT_repo="1"

    local exit_code
    zsh bin/tos.zsh team_of_six delete project 2>&1
    exit_code=$?

    # Overall exit must be non-zero (the delete failed).
    assert "${exit_code}" not_equals "0"

    # Despite the failure, scope revocation MUST appear in the log.
    assert_mock_called /tmp/tos_mock_gh_calls.log "--remove-scopes delete_repo"
}

# ---------------------------------------------------------------------------
# TEST 3 — HITL gate: absent CONFIRM=TRUE blocks delete project entirely
# ---------------------------------------------------------------------------
@test '[delete project — negative, no CONFIRM] Absent CONFIRM=TRUE halts immediately' {
    cat > "${TOS_INBOX}" <<'PAYLOAD'
===TOS_META_START===
TARGET_PROJECT=team_of_six
TARGET_TRINITY=0
TITLE=Delete project
BODY=Confirm is missing.
===TOS_META_END===
PAYLOAD

    local output exit_code
    output=$(zsh bin/tos.zsh team_of_six delete project 2>&1)
    exit_code=$?

    assert "${exit_code}" not_equals "0"

    # No gh repo delete must have been called.
    assert_mock_not_called /tmp/tos_mock_gh_calls.log "repo delete"

    # Output must reference CONFIRM.
    echo "${output}" | grep -qi "CONFIRM\|confirmation required"
    assert "$?" equals "0"
}
