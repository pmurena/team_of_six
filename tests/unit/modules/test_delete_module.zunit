#!/usr/bin/env zunit

@setup {
    source "${PWD}/tests/shared/zunit_helpers/scaffold.zsh"
    source "${PWD}/tests/shared/zunit_helpers/mocks.zsh"
    source "${PWD}/tests/shared/zunit_helpers/assertions.zsh"
    scaffold_setUp
    reset_mocks
    _FIXTURES="${PWD}/tests/shared/payloads"
    echo "test_architect:SOFT_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_0.lock"
    export TOS_ACTIVE_TRINITY="0"
    
    _SANDBOX_PROJECT="${TOS_SANDBOX}/team_of_six"
    mkdir -p "${_SANDBOX_PROJECT}"
}

@teardown { scaffold_tearDown; }

@test '[delete project — positive] PAT MFA escalation before delete; scope revoked in EXIT trap' {
    scaffold_write_inbox "${_FIXTURES}/meta_confirm_zero.md"
    local exit_code=0
    
    # Run the module
    zsh "${TOS_MNT_ROOT}/.local/bin/tos.zsh" team_of_six delete project >/dev/null 2>&1 || exit_code=$?
    
    assert "${exit_code}" equals 0

    # 1. Verify the GRANT happens BEFORE the DELETE (String MUST be on one line)
    assert_mock_call_order /tmp/tos_mock_gh_calls.log "auth refresh -h github.com -s delete_repo" "repo delete"

    # 2. Verify the REVOKE happens (via the EXIT trap)
    assert_mock_called /tmp/tos_mock_gh_calls.log "auth refresh -h github.com --remove-scopes delete_repo"
    
    assert_dir_not_exists "${_SANDBOX_PROJECT}"
}

# ... rest of tests ...
@test '[delete project — negative] Scope revocation fires even when repo delete fails' {
    scaffold_write_inbox "${_FIXTURES}/meta_confirm_zero.md"
    export TOS_MOCK_GH_EXIT_repo="1"
    zsh "${TOS_MNT_ROOT}/.local/bin/tos.zsh" team_of_six delete project >/dev/null 2>&1 || true
    assert_mock_called /tmp/tos_mock_gh_calls.log "remove-scopes delete_repo"
    assert 1 equals 1
}

@test '[delete project — negative, no CONFIRM] Absent CONFIRM=TRUE halts immediately' {
    cat > "${TOS_INBOX}" <<'PAYLOAD'
===TOS_META_START===
TARGET_PROJECT=team_of_six
TARGET_TRINITY=0
TITLE=Delete project
BODY=Confirm is missing.
===TOS_META_END===
PAYLOAD
    local output
    local exit_code=0
    output=$(zsh "${TOS_MNT_ROOT}/.local/bin/tos.zsh" team_of_six delete project 2>&1) || exit_code=$?
    if [[ "${exit_code}" -ne 0 ]]; then assert 1 equals 1; else fail "Expected non-zero exit code"; fi
    assert_mock_not_called /tmp/tos_mock_gh_calls.log "repo delete"
    if echo "${output}" | grep -qi "CONFIRM\|confirmation required"; then assert 1 equals 1; else fail "Did not output confirmation requirement."; fi
}
