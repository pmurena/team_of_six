#!/usr/bin/env zunit
# =============================================================================
# test/unit/test_parse_blocks.zunit
# =============================================================================

@setup {
    source "${PWD}/tests/helpers/scaffold.zsh"
    scaffold_setUp
    
    export TEST_INBOX="/tmp/tos_parse_test_inbox.md"
    export TEST_OUTDIR="/tmp/tos_parse_test_out"
    mkdir -p "$TEST_OUTDIR"
}

@teardown {
    scaffold_tearDown
    rm -f "$TEST_INBOX"
    rm -rf "$TEST_OUTDIR"
}

# ---------------------------------------------------------------------------
# TEST 1 — Parse META block (key-value)
# ---------------------------------------------------------------------------
@test 'parse_blocks auto-detects META block and extracts kv pairs' {
    cat > "$TEST_INBOX" <<'EOF'
===TOS_META_START===
TARGET_PROJECT=team_of_six
TARGET_TRINITY=2
CONFIRM=TRUE
===TOS_META_END===
EOF

    zsh bin/utils/parse_blocks.zsh "$TEST_INBOX" "$TEST_OUTDIR"
    assert "$?" equals 0
    
    local p_val=$(cat "$TEST_OUTDIR/1/TARGET_PROJECT.txt" 2>/dev/null)
    local t_val=$(cat "$TEST_OUTDIR/1/TARGET_TRINITY.txt" 2>/dev/null)
    local c_val=$(cat "$TEST_OUTDIR/1/CONFIRM.txt" 2>/dev/null)

    assert "$p_val" same_as "team_of_six"
    assert "$t_val" same_as "2"
    assert "$c_val" same_as "TRUE"
}

# ---------------------------------------------------------------------------
# TEST 2 — Parse FILE block (raw)
# ---------------------------------------------------------------------------
@test 'parse_blocks auto-detects FILE block and preserves raw formatting' {
    # Using Python instead of Rust to avoid curly braces breaking ZUnit's parser
    cat > "$TEST_INBOX" <<'EOF'
===TOS_FILE_START: src/main.py===
def main():
    print("Hello, team of six!")
===TOS_FILE_END===
EOF

    zsh bin/utils/parse_blocks.zsh "$TEST_INBOX" "$TEST_OUTDIR"
    assert "$?" equals 0

    local target=$(cat "$TEST_OUTDIR/file_1/_TARGET.txt" 2>/dev/null)
    assert "$target" same_as "src/main.py"
    
    local content=$(cat "$TEST_OUTDIR/file_1/RAW_BODY.txt" 2>/dev/null)
    if [[ "$content" == *'print("Hello'* ]]; then
        assert 1 equals 1
    else
        fail "Raw body was not preserved correctly: $content"
    fi
}

# ---------------------------------------------------------------------------
# TEST 3 — Parse FILE missing target path
# ---------------------------------------------------------------------------
@test 'parse_blocks rejects FILE block without a target path' {
    cat > "$TEST_INBOX" <<'EOF'
===TOS_FILE_START===
def main(): pass
===TOS_FILE_END===
EOF

    local output
    local exit_code=0
    output=$(zsh bin/utils/parse_blocks.zsh "$TEST_INBOX" "$TEST_OUTDIR" 2>&1) || exit_code=$?
    
    if [[ "${exit_code}" -ne 0 ]]; then
        assert 1 equals 1
    else
        fail "Expected non-zero exit for missing path"
    fi

    if [[ "$output" == *"ERROR: FILE block 1 has no path"* ]]; then
        assert 1 equals 1
    else
        fail "Did not output expected error message. Got: $output"
    fi
}

# ---------------------------------------------------------------------------
# TEST 4 — Parse ISSUE and COMMENT blocks
# ---------------------------------------------------------------------------
@test 'parse_blocks auto-detects ISSUE and COMMENT blocks' {
    cat > "$TEST_INBOX" <<'EOF'
===TOS_ISSUE_START===
TITLE=Houston, we have a bug
BODY=It breaks when I click the thing.
===TOS_ISSUE_END===
===TOS_COMMENT_START===
BODY=I am looking into this now.
===TOS_COMMENT_END===
EOF

    zsh bin/utils/parse_blocks.zsh "$TEST_INBOX" "$TEST_OUTDIR"
    assert "$?" equals 0

    local t_val=$(cat "$TEST_OUTDIR/issue_1/TITLE.txt" 2>/dev/null)
    local b_val=$(cat "$TEST_OUTDIR/issue_1/BODY.txt" 2>/dev/null)
    local c_val=$(cat "$TEST_OUTDIR/comment_1/BODY.txt" 2>/dev/null)

    assert "$t_val" same_as "Houston, we have a bug"
    assert "$b_val" same_as "It breaks when I click the thing."
    assert "$c_val" same_as "I am looking into this now."
}
