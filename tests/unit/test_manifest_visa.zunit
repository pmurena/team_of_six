#!/usr/bin/env zunit
@setup {
    source "${PWD}/tests/shared/zunit_helpers/scaffold.zsh"
    source "${PWD}/tests/shared/zunit_helpers/assertions.zsh"
    scaffold_setUp
    export TOS_MOCK_BIN="/tmp/tos_mock_bin_$$"
    mkdir -p "${TOS_MOCK_BIN}"
    export PATH="${TOS_MOCK_BIN}:$PATH"
    
    export _SANDBOX_PROJECT="${TOS_SANDBOX}/team_of_six"
    mkdir -p "${_SANDBOX_PROJECT}"
    git -C "${_SANDBOX_PROJECT}" init -q
    git -C "${_SANDBOX_PROJECT}" commit -q --allow-empty -m "Initial commit"
    git -C "${_SANDBOX_PROJECT}" checkout -q -b tos-work-1
    
    echo "test_architect:HARD_LOCK" > "${TOS_LOCKS}/team_of_six_trinity_1.lock"
    export TOS_ACTIVE_TRINITY="1"
    
    # Hybrid mock: Silences 'gh' and intercepts 'git push', allowing real git locally
    cat > "${TOS_MOCK_BIN}/gh" <<'INNER'
#!/usr/bin/env zsh
exit 0
INNER
    chmod +x "${TOS_MOCK_BIN}/gh"

    cat > "${TOS_MOCK_BIN}/git" <<'INNER'
#!/usr/bin/env zsh
if [[ "$1" == "rev-parse" && "$*" == *"--abbrev-ref HEAD"* ]]; then echo "tos-work-1"; exit 0; fi
if [[ "$*" == *"push"* ]]; then exit 0; fi
if [[ "$*" == *"remote get-url"* ]]; then echo "git@github.com:test/team_of_six.git"; exit 0; fi
REAL_GIT=$(command -v git | grep -v tos_mock_bin | head -n 1)
[[ -z "$REAL_GIT" ]] && REAL_GIT="/usr/bin/git"
"$REAL_GIT" "$@"
exit $?
INNER
    chmod +x "${TOS_MOCK_BIN}/git"
}
@teardown { scaffold_tearDown; rm -rf "${TOS_MOCK_BIN}" 2>/dev/null; }

@test 'File listed in manifest passes the visa check' {
    echo "target.zsh" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    echo "===TOS_META_START===\nTARGET_PROJECT=team_of_six\nTARGET_TRINITY=1\nTITLE=Test\n===TOS_META_END===\n===TOS_FILE_START: target.zsh===\ncontent\n===TOS_FILE_END===" > "${TOS_INBOX}"
    
    local output
    local exit_code=0
    output=$(zsh "${TOS_MNT_ROOT}/.local/bin/tos.zsh" team_of_six write code 2>&1) || exit_code=$?
    
    if [[ "${exit_code}" -eq 0 ]]; then 
        assert 1 equals 1
    else 
        fail "Expected 0 but got ${exit_code}. Output: ${output}"
    fi
}

@test 'File not in manifest causes SEC-FAULT with descriptive output' {
    echo "allowed.zsh" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    echo "===TOS_META_START===\nTARGET_PROJECT=team_of_six\nTARGET_TRINITY=1\nTITLE=Test\n===TOS_META_END===\n===TOS_FILE_START: rogue.zsh===\ncontent\n===TOS_FILE_END===" > "${TOS_INBOX}"
    
    local output
    local exit_code=0
    output=$(zsh "${TOS_MNT_ROOT}/.local/bin/tos.zsh" team_of_six write code 2>&1) || exit_code=$?
    
    if [[ "${exit_code}" -ne 0 ]]; then
        if echo "${output}" | grep -qi "SEC-FAULT"; then assert 1 equals 1; else fail "No SEC-FAULT message found. Output: ${output}"; fi
    else
        fail "Gateway did not block request! Output: ${output}"
    fi
}

@test 'Path traversal with .. is rejected before manifest lookup' {
    echo "allowed.zsh" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    echo "===TOS_META_START===\nTARGET_PROJECT=team_of_six\nTARGET_TRINITY=1\nTITLE=Test\n===TOS_META_END===\n===TOS_FILE_START: ../rogue.zsh===\ncontent\n===TOS_FILE_END===" > "${TOS_INBOX}"
    
    local output
    local exit_code=0
    output=$(zsh "${TOS_MNT_ROOT}/.local/bin/tos.zsh" team_of_six write code 2>&1) || exit_code=$?
    
    if [[ "${exit_code}" -ne 0 ]]; then
        if echo "${output}" | grep -qi "SEC-FAULT"; then assert 1 equals 1; else fail "No traversal message found. Output: ${output}"; fi
    else
        fail "Gateway did not block request! Output: ${output}"
    fi
}

@test 'Absolute path is rejected by the visa check' {
    echo "allowed.zsh" > "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    echo "===TOS_META_START===\nTARGET_PROJECT=team_of_six\nTARGET_TRINITY=1\nTITLE=Test\n===TOS_META_END===\n===TOS_FILE_START: /etc/rogue.zsh===\ncontent\n===TOS_FILE_END===" > "${TOS_INBOX}"
    
    local output
    local exit_code=0
    output=$(zsh "${TOS_MNT_ROOT}/.local/bin/tos.zsh" team_of_six write code 2>&1) || exit_code=$?
    
    if [[ "${exit_code}" -ne 0 ]]; then
        assert 1 equals 1
    else
        fail "Gateway did not block request! Output: ${output}"
    fi
}

@test 'No manifest file present causes write code to be blocked' {
    rm -f "${TOS_LOCKS}/team_of_six_trinity_1.manifest"
    echo "===TOS_META_START===\nTARGET_PROJECT=team_of_six\nTARGET_TRINITY=1\nTITLE=Test\n===TOS_META_END===\n===TOS_FILE_START: target.zsh===\ncontent\n===TOS_FILE_END===" > "${TOS_INBOX}"
    
    local output
    local exit_code=0
    output=$(zsh "${TOS_MNT_ROOT}/.local/bin/tos.zsh" team_of_six write code 2>&1) || exit_code=$?
    
    if [[ "${exit_code}" -ne 0 ]]; then
        if echo "${output}" | grep -qi "manifest"; then assert 1 equals 1; else fail "No manifest message found. Output: ${output}"; fi
    else
        fail "Gateway did not block request! Output: ${output}"
    fi
}
