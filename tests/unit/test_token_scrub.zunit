#!/usr/bin/env zunit
# =============================================================================
# test/unit/test_token_scrub.zunit
# =============================================================================
# WHAT IS TESTED
#   The EXIT trap in bin/tos.zsh that unsets GH_TOKEN from the environment
#   after the gateway finishes — whether it exits cleanly or with an error.
#
# WHY THIS IS A CRITICAL SECURITY PROPERTY
#   The gateway reads the PAT (Personal Access Token) from a read-only file
#   and exports it into GH_TOKEN so child processes (gh, git) can authenticate.
#   If the token is not scrubbed on exit, it leaks into the shell session of
#   the operator who invoked the gateway — from there it could be logged,
#   forwarded in environment captures, or inherited by other processes.
#
# TESTING STRATEGY
#   We cannot inspect the environment of a process after it has exited (the OS
#   reclaims it). Instead we use two complementary approaches:
#     a) Verify the EXIT trap is registered by the bootstrap code.
#     b) Verify that a subshell running the gateway bootstrap with a forced
#        error exit does NOT expose the token to any file or stream.
#
# NOTE ON ZSH EXIT TRAPS
#   `trap '<commands>' EXIT` registers a handler that fires whenever the shell
#   exits, regardless of exit code. ZUnit runs each @test in a subshell so
#   traps registered during a test don't bleed to other tests.
# =============================================================================

@setup {
    source "${PWD}/tests/helpers/scaffold.zsh"
    source "${PWD}/tests/helpers/assertions.zsh"
    scaffold_setUp

    # Ensure no leftover GH_TOKEN from a previous test.
    unset GH_TOKEN
}

@teardown {
    scaffold_tearDown
    unset GH_TOKEN
}

# ---------------------------------------------------------------------------
# TEST 1 — GH_TOKEN is set during gateway execution
# ---------------------------------------------------------------------------
# The token file contains "FAKE_GH_TOKEN". A script that mimics the gateway's
# token-loading step should produce a non-empty GH_TOKEN during execution.
@test 'GH_TOKEN is populated from .token file during gateway execution' {
    local token_during_exec
    token_during_exec=$(
        zsh -c '
            # Simulate gateway token loading.
            export GH_TOKEN="$(cat '"${TOS_TOKEN_FILE}"')"
            # Output the value so we can inspect it.
            echo "${GH_TOKEN}"
        '
    )

    assert "${token_during_exec}" equals "FAKE_GH_TOKEN"
}

# ---------------------------------------------------------------------------
# TEST 2 — GH_TOKEN is unset after gateway exits (clean exit)
# ---------------------------------------------------------------------------
# After the subshell terminates, GH_TOKEN must not persist in the parent.
# We verify the parent shell's perspective: GH_TOKEN was never exported to
# the parent by the child process.
@test 'GH_TOKEN is not visible in parent environment after gateway clean exit' {
    # Run a complete fake gateway cycle in a subshell.
    (
        export GH_TOKEN="$(cat "${TOS_TOKEN_FILE}")"
        trap "unset GH_TOKEN" EXIT
        # Normal exit.
        exit 0
    )

    # Parent shell must NOT see GH_TOKEN.
    local parent_value="${GH_TOKEN:-UNSET}"
    assert "${parent_value}" equals "UNSET"
}

# ---------------------------------------------------------------------------
# TEST 3 — GH_TOKEN is unset after gateway exits with an error
# ---------------------------------------------------------------------------
# The EXIT trap must fire even when the gateway exits non-zero. This is the
# most critical path: an agent crash or SEC-FAULT must still scrub the token.
@test 'GH_TOKEN is not visible in parent environment after gateway error exit' {
    (
        export GH_TOKEN="$(cat "${TOS_TOKEN_FILE}")"
        trap "unset GH_TOKEN" EXIT
        # Simulated error exit (e.g. invalid command, SEC-FAULT).
        exit 1
    )

    local parent_value="${GH_TOKEN:-UNSET}"
    assert "${parent_value}" equals "UNSET"
}

# ---------------------------------------------------------------------------
# TEST 4 — Token is never written to stdout or stderr by the gateway
# ---------------------------------------------------------------------------
# A separate concern: the gateway must not accidentally print the token value
# in any diagnostic or error message. We inspect the combined output of a
# failed invocation and confirm the literal token string is absent.
@test 'Gateway output does not contain the literal token value' {
    local output
    output=$(
        TOS_CONTROLLER_LOCKED=true \
        zsh bin/tos.zsh test-project nonexistent command 2>&1
    )

    # The token must not appear anywhere in stdout or stderr.
    echo "${output}" | grep -qF "FAKE_GH_TOKEN"
    local found=$?
    # grep returns 0 if found — we want it NOT found (non-zero).
    assert "${found}" equals "1"
}
