#!/bin/zsh
# ==============================================================================
# Team of Six - Global Gateway (Strict Config Edition)
# ==============================================================================

# === STAGE 1: SECURITY PERIMETER ===
[[ -z "$SUDO_USER" || "$TOS_CONTROLLER_LOCKED" != "true" ]] && exit 1

# === STAGE 2: CONFIGURATION INJECTION ===
TOS_GLOBAL_CONF="/mnt/team_of_six/.local/conf/config"
if [[ -f "$TOS_GLOBAL_CONF" ]]; then
    source "$TOS_GLOBAL_CONF"
else
    echo "🚨 [ERROR] Missing global configuration at $TOS_GLOBAL_CONF" >&2
    exit 1
fi

# Ensure critical variables populated by config
[[ -z "$TOS_BIN" || -z "$TOS_IPC" ]] && { echo "🚨 [ERROR] Config failed to load core paths." >&2; exit 1; }

# === STAGE 3: ARGUMENT PARSING ===
PROJECT_NAME="$1"
MODULE="$2"

# Shift the project and module so $@ only contains the action and parameters
shift 2 

# === STAGE 4: ENVIRONMENT & CONTEXT ===
# Resolve active trinity for the specific project (if initialized)
if [[ -f "$TOS_SANDBOX/$PROJECT_NAME/.tos/active_trinity" ]]; then
    export TOS_ACTIVE_TRINITY=$(cat "$TOS_SANDBOX/$PROJECT_NAME/.tos/active_trinity")
else
    export TOS_ACTIVE_TRINITY="0"
fi

# === STAGE 5: DISPATCH & LOCK ENFORCEMENT ===
ACTION="$1"
SUB_PATH="soft"

if [[ "$MODULE" == "write" ]]; then
    case "$ACTION" in
        code|trinity) SUB_PATH="hard" ;;
        issue|comment) SUB_PATH="soft" ;;
    esac
elif [[ "$MODULE" == "sync" ]]; then
    SUB_PATH="soft"
fi

if [[ "$SUB_PATH" == "hard" && "$TOS_ACTIVE_TRINITY" == "0" ]]; then
    echo "🚨 [ERROR] Write Denied: This operation requires a Hard Lock." >&2
    exit 1
fi

case "$MODULE" in
    "sync")   TARGET_SCRIPT="$TOS_BIN/sync/tos" ;;
    "write")  TARGET_SCRIPT="$TOS_BIN/write/tos" ;;
    "system") TARGET_SCRIPT="$TOS_BIN/system/tos" ;;
    *) echo "Usage: tos <project> <sync|write|system> <action>"; exit 1 ;;
esac

# === STAGE 6: EXECUTION ===
# Ensure the central IPC directory exists for this user before teeing to it
mkdir -p "$TOS_IPC" 2>/dev/null

# Execute target script and tee output to the central Outbox defined by the config
{ "$TARGET_SCRIPT" "$PROJECT_NAME" "$@" } 2>&1 | tee "$TOS_CONTEXT"
